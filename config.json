    {"name": "European Axis", "color": "#8B0000", "marker": "s",
     "members": ["GER", "ITA", "HUN", "ROM", "BUL", "FIN", "SPR"]},
    {"name": "Soviets & Puppets", "color": "#FF0000", "marker": "^",
